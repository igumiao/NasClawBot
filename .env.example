# ── M-Team API ──────────────────────────────────────────
MTEAM_BASE_URL=https://api.m-team.cc
MTEAM_API_KEY=your-mteam-api-key

# ── qBittorrent ────────────────────────────────────────
QB_BASE_URL=http://10.10.10.5:8085/
QB_USERNAME=admin
QB_PASSWORD=your-qb-password

# ── LLM ────────────────────────────────────────────────
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-deepseek-api-key
# LLM_REASONING_SPLIT=true
# LLM_LOG_RAW_OUTPUT=false

# ── External APIs ──────────────────────────────────────
TMDB_API_KEY=your-tmdb-api-key
TAVILY_API_KEY=your-tavily-api-key

# ── Database ───────────────────────────────────────────
# DATABASE_PATH=nas_media_agent.db
# TASK_DB_PATH=memory/runtime/tasks.db

# ── Download ───────────────────────────────────────────
# Agent 下载默认保存路径。Docker 部署使用容器内路径（由 volume 映射提供）。
# 开发环境可留空，Agent 将不设默认路径（每次下载需手动指定）。
DOWNLOAD_DEFAULT_SAVE_PATH=/影视/未整理

# ── Filesystem MCP ─────────────────────────────────────
# 允许 Agent 访问的目录（逗号分隔多个）。Docker 部署使用容器内路径。
# 设为 false/0/no 可完全禁用 MCP filesystem 功能。
MCP_FS_ALLOWED_DIRS=/影视
# MCP_FS_ENABLED=true

# ── Runtime Task System ────────────────────────────────
# Worker 轮询间隔（秒）
# TASK_WORKER_TICK_SECONDS=2

# 下载监视默认轮询间隔（秒），实际使用动态 ETA 算法
# DOWNLOAD_WATCH_POLL_SECONDS=30

# 下载监视 qB 错误最大退避时间（秒）
# DOWNLOAD_WATCH_ERROR_BACKOFF_MAX_SECONDS=600

# 任务租约时长（秒），超时未心跳的任务会被其他 worker 接管
# TASK_LEASE_SECONDS=120

# 全局 handler 并发数
# TASK_WORKER_CONCURRENCY=4

# download_watch 类型任务并发数
# DOWNLOAD_WATCH_CONCURRENCY=4

# organize_download 类型任务并发数（串行整理，防止并发的 MCP 操作互相踩踏）
# ORGANIZE_WORKER_CONCURRENCY=1

# Windows→WSL 路径前缀映射（仅跨 OS 部署需要），格式: D:\->/mnt/d/
# QB_PATH_MAPPING=

# 终态任务（SUCCEEDED/FAILED/CANCELLED）最大保留时间（秒），默认 3600（1 小时）
# TASK_PURGE_MAX_AGE_SECONDS=3600

# 已消费事件（已确认 + 已注入）保留时间（秒），默认 86400（24 小时）
# EVENT_CONSUMED_PURGE_SECONDS=86400

# 事件绝对最大保留时间（秒），超时无论是否确认/注入都删除，默认 604800（7 天）
# EVENT_MAX_AGE_SECONDS=604800

# ── Docker ─────────────────────────────────────────────
# 主机端口映射（默认 18000）
# APP_PORT=18000

# ── General ────────────────────────────────────────────
# APP_TIMEZONE=Asia/Shanghai
# LOG_LEVEL=INFO
# CONTEXT_WINDOW=128000
